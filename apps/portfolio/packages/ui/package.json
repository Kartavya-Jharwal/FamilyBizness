{
  "name": "@fb/ui",
  "version": "3.11.0",
  "type": "module",
  "description": "FamilyBizness UI components based on shadcn/ui and Tailwind CSS",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./chart": {
      "import": "./dist/chart.js",
      "types": "./dist/src/chart.d.ts"
    },
    "./styles": {
      "import": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "familybizness",
    "ui",
    "components",
    "shadcn",
    "tailwind",
    "react",
    "components"
  ],
  "author": "FamilyBizness contributors; original authors credited in NOTICE",
  "license": "MIT",
  "scripts": {
    "build": "tsup && bun run build:types",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm --dir ../.. exec oxlint --type-aware packages/ui && pnpm lint:eslint",
    "lint:fix": "pnpm --dir ../.. exec oxlint --type-aware --fix packages/ui && pnpm lint:eslint --fix",
    "lint:quiet": "pnpm --dir ../.. exec oxlint --type-aware --quiet packages/ui && pnpm lint:eslint --quiet",
    "lint:eslint": "eslint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "build:types": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@internationalized/date": "^3.11.0",
    "@internationalized/number": "^3.6.5",
    "@number-flow/react": "^0.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-aria/i18n": "^3.12.15",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.561.0",
    "motion": "^12.34.0",
    "nanoid": "^5.1.16",
    "react-aria-components": "^1.15.1",
    "react-day-picker": "^9.13.2",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.71.1",
    "react-number-format": "^5.4.4",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "i18next": "^25.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "i18next": "^25.6.0",
    "react-i18next": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "private": true
}
